# ─────────────────────────────────────────
#  RVSCET Placement Portal — Backend ENV
#  Copy this file to .env and fill values.
#  NEVER commit .env to git.
# ─────────────────────────────────────────

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
# Get from: https://cloud.mongodb.com → Connect → Drivers
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT — use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Frontend URL (used in CORS + email links)
# Dev:        http://localhost:5173
# Production: https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# ─── Nodemailer SMTP (Gmail) ───────────────
# 1. Enable 2-Step Verification on your Google account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create an App Password for "Mail"
# 4. Paste the 16-char password below (no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_16char_app_password
MAIL_FROM=RVSCET Portal <noreply@rvscet.ac.in>
